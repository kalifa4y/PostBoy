{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/morning",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/check-reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/evening",
      "schedule": "0 22 * * *"
    }
  ]
}
