# PostBoy - Configuration de l'environnement local

# Serveur Fastify
PORT=3001
HOST=127.0.0.1

# Chemins de stockage
DATABASE_PATH=./data/postboy.db
UPLOADS_DIR=./uploads

# Fuseau horaire par défaut
DEFAULT_TIMEZONE=Africa/Bamako

# URL de l'interface client (pour CORS)
CLIENT_URL=http://localhost:5173

# Notifications Email SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PostBoy <notifications@example.com>
NOTIFICATION_EMAIL=



