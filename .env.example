# PostBoy - Configuration de l'environnement local

# Serveur Fastify
PORT=3001
HOST=127.0.0.1

# Clé secrète de chiffrement local (minimum 32 caractères pour AES-256-GCM)
APP_SECRET=postboy_secret_key_change_me_local_development_only_32char_key!

# Chemins de stockage
DATABASE_PATH=./data/postboy.db
UPLOADS_DIR=./uploads

# Fuseau horaire par défaut
DEFAULT_TIMEZONE=Africa/Bamako

# URL de l'interface client (pour CORS)
CLIENT_URL=http://localhost:5173

# Configuration OAuth 2.0 Officielle (Phase 6 - Serveur uniquement)
# TikTok (TikTok for Developers)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:3001/api/social-accounts/tiktok/callback

# Instagram (Meta Developers / Instagram API)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:3001/api/social-accounts/instagram/callback

# YouTube (Google Cloud Console / YouTube Data API v3)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:3001/api/social-accounts/youtube/callback

# Configuration du Moteur de Publication Automatique (Phase 7)
# Intervalle de scrutation de la base SQLite en millisecondes (défaut: 30000 -> 30s)
PUBLICATION_POLL_INTERVAL_MS=30000

# Nombre maximum de publications traitées en simultané (défaut: 5)
PUBLICATION_CONCURRENCY=5

# Délai d'attente maximum pour les requêtes HTTP vers les réseaux sociaux en ms (défaut: 60000 -> 60s)
SOCIAL_API_TIMEOUT_MS=60000

# Notifications Email SMTP (Phase 9)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PostBoy <notifications@example.com>
NOTIFICATION_EMAIL=



