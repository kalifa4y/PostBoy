# PostBoy - Variables d'environnement (Exemple / Modèle)
# Copiez ce fichier vers .env et complétez les valeurs selon votre environnement.
# Ne commitez JAMAIS de fichier .env contenant des tokens réels.

# Configuration du Serveur Local (utilisé en dev)
PORT=3001
HOST=127.0.0.1

# Base de données Cloud (Turso / LibSQL)
# Indiquez vos identifiants Turso pour la persistance cloud (PC + Mobile).
# Si omis en local, un fallback automatique SQLite sera utilisé (data/postboy.db).
TURSO_DATABASE_URL=libsql://postboy-db-votre-identifiant.turso.io
TURSO_AUTH_TOKEN=votre_token_jwt_turso

# Chemins de stockage local (Vidéos et fallback local)
# Les vidéos restent 100% locales sur votre PC.
DATABASE_PATH=./data/postboy.db
UPLOADS_DIR=./uploads

# Fuseau horaire de l'application (UTC / GMT pour Bamako)
DEFAULT_TIMEZONE=Africa/Bamako

# URL du client pour CORS
# Local : http://localhost:5173
# Production Vercel : https://pbplan.vercel.app
CLIENT_URL=https://pbplan.vercel.app

# Clé de protection pour les routes Vercel Cron (/api/cron/*)
# Définissez une clé secrète aléatoire robuste en production.
CRON_SECRET=votre_cle_secrete_cron

# Notifications Email SMTP (Discipline quotidienne 06:00, rappels, retards, bilans 22:00)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-adresse@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-d-application
SMTP_FROM=PostBoy <notifications@votre-domaine.com>
NOTIFICATION_EMAIL=votre-email-personnel@gmail.com
